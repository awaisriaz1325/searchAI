{
  "name": "searchai",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "bench"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:model": "vitest run --project model",
    "format": "prettier --write .",
    "ingest": "tsx packages/db/src/cli-ingest.ts",
    "extract": "tsx packages/eval/src/cli-extract.ts",
    "eval": "tsx packages/eval/src/cli-eval.ts",
    "bench:load": "tsx bench/src/load-2m.ts",
    "bench:strategies": "tsx bench/src/strategies.ts",
    "bench:jsonb": "tsx bench/src/jsonb-vs-column.ts",
    "bench:load-test": "tsx bench/src/loadtest.ts",
    "cost": "tsx bench/src/cost-report.ts"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "eslint": "10.14.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
