{
  "name": "searchai",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "bench"],
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:model": "vitest run --project model",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "eslint": "10.14.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
